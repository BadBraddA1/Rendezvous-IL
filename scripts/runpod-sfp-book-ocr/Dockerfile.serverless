# Slim serverless OCR worker — RapidOCR + ONNX (no multi-GB PyTorch)
FROM runpod/base:0.6.2-cuda12.1.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-serverless.txt .
RUN pip install --no-cache-dir -r requirements-serverless.txt

COPY postprocess.py segment_match.py handler.py ./

ENV PYTHONUNBUFFERED=1
ENV OCR_ENGINE=rapid
CMD ["python", "-u", "handler.py"]
